# Optional Cloud / desktop secrets (top-level keys, not nested).
# Copy to secrets.toml and fill in. Without keys the app uses the
# nightly dump first, then Yahoo. Live 1-min bars and APEX intraday
# need Alpaca.

ALPACA_API_KEY = ""
ALPACA_SECRET_KEY = ""

# Optional Ignition phone alerts (ntfy.sh topic name)
# NTFY_TOPIC = ""

# 4-digit PIN to edit the public Bull List. Everyone can view the list.
# Leave this unset to keep the list view-only. Streamlit Cloud: add the
# same key under App settings → Secrets.
# BULL_LIST_PIN = "0000"
